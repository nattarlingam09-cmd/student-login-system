# ==============================================================
# EduPortal — Student Login & Registration System Environment Config
# ==============================================================
# Copy this file to '.env' inside the 'backend/' folder:
# In Windows PowerShell:
# Copy-Item backend\.env.example backend\.env
# ==============================================================

# Server Network Port (Default: 5000)
PORT=5000

# Node Environment: 'development' or 'production'
# In development: Cookies allow standard HTTP localhost
# In production: Cookies enforce Secure (HTTPS only) and SameSite=Strict
NODE_ENV=development

# MongoDB Atlas Connection String
# Replace <username>, <password>, and <cluster-url> with your Atlas cluster details
# Database name must be: student_login_db
# Example: mongodb+srv://student_admin:MySecurePass123@cluster0.abcde.mongodb.net/student_login_db?retryWrites=true&w=majority&appName=EduPortal
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-url>/student_login_db?retryWrites=true&w=majority

# JWT Secret Key for signing authentication tokens
# Generate a strong 64-character random key in PowerShell using:
# -join ((65..90) + (97..122) + (48..57) | Get-Random -Count 64 | ForEach-Object {[char]$_})
JWT_SECRET=replace_with_your_strong_random_jwt_secret_key_minimum_32_characters

# JWT Expiration Period (e.g., 24h, 7d)
JWT_EXPIRES_IN=24h

# Frontend Origin (Used if serving frontend from separate dev server like Live Server)
# If serving directly through Express, this can remain default
FRONTEND_ORIGIN=http://localhost:5000
